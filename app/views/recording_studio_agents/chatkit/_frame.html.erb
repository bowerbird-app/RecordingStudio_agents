<% full_bleed = local_assigns[:fill] %>
<% chat_classes = full_bleed ? "block h-dvh w-full" : "block w-full h-[min(40rem,calc(100dvh-16rem))]" %>
<% chat = capture do %>
  <%= content_tag(
    "openai-chatkit",
    "",
    id: "recording-studio-agents-chatkit",
    class: chat_classes,
    data: {
      recording_studio_agents_chatkit: true,
      endpoint: endpoint,
      domain_key: RecordingStudioAgents.configuration.chatkit_domain_key,
      options: chatkit_options.to_json
    }
  ) %>
<% end %>
<% if full_bleed %>
  <%= chat %>
<% else %>
  <%= render FlatPack::Card::Component.new(background: :default, padding: :none, class: "w-full") do %>
    <div class="overflow-hidden rounded-[var(--card-radius)]">
      <%= chat %>
    </div>
  <% end %>
<% end %>
<script src="https://cdn.platform.openai.com/deployments/chatkit/chatkit.js" async></script>
<%= javascript_include_tag "recording_studio_agents/chatkit" %>
