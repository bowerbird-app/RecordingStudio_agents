<openai-chatkit id="recording-studio-agents-chatkit" class="block h-[640px] w-full"></openai-chatkit>
<script src="https://cdn.platform.openai.com/deployments/chatkit/chatkit.js" async></script>
<%= javascript_tag do %>
  const frame = document.getElementById("recording-studio-agents-chatkit")
  const endpoint = <%= json_escape(endpoint.to_json) %>
  const domainKey = <%= json_escape(RecordingStudioAgents.configuration.chatkit_domain_key.to_json) %>
  const csrf = document.querySelector("meta[name='csrf-token']")?.content

  function csrfHeaders(headers) {
    const next = new Headers(headers || {})
    if (csrf) next.set("X-CSRF-Token", csrf)
    next.set("Content-Type", "application/json")
    return next
  }

  customElements.whenDefined("openai-chatkit").then(() => {
    frame.setOptions({
      api: {
        url: endpoint,
        domainKey: domainKey,
        fetch: (url, options) => fetch(url, {
          ...options,
          headers: csrfHeaders(options && options.headers),
          credentials: "same-origin"
        })
      }
    })
  })
<% end %>
