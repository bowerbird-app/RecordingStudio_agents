<% dummy_page_nav(title: "Page chat", back_url: agent_chat_path, back_label: "All chats") %>

<div class="flex w-full flex-col gap-4">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Press kit",
    subtitle: "A chat that stays on this page.",
    variant: :h1
  ) %>

  <% if @page_recording %>
    <% chat = PressKitPageChat.for(@page_recording) %>
    <%= recording_studio_agents_chatkit(page_recording: chat.page_recording, chatkit_options: chat.chatkit_options) %>
  <% else %>
    <%= recording_studio_agents_chatkit %>
  <% end %>
</div>
