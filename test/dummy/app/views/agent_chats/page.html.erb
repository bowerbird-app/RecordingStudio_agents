<% dummy_page_nav(
  title: "Press kit",
  subtitle: "A chat that stays on this page.",
  back_url: agent_chat_path,
  back_label: "All chats"
) %>

<div class="flex w-full flex-col gap-4">

  <% if @page_recording %>
    <% chat = PressKitPageChat.for(@page_recording) %>
    <%= recording_studio_agents_chatkit(page_recording: chat.page_recording, chatkit_options: chat.chatkit_options) %>
  <% else %>
    <%= render FlatPack::Alert::Component.new(
      title: "Press kit is not on this workspace yet",
      description: "Run bin/rails db:seed",
      style: :info
    ) %>
  <% end %>
</div>
