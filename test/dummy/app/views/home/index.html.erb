<% dummy_page_nav(title: "Page librarian", back_url: root_path) %>

<%= render FlatPack::PageTitle::Component.new(
  title: "Page librarian",
  subtitle: "Point it at this workspace and it finds the page you named.",
  variant: :h1
) %>

<%= form_with url: agents_demo_path, method: :post do %>
  <%= render FlatPack::Button::Component.new(
    text: "Find Getting Started",
    style: :primary,
    size: :md,
    type: "submit"
  ) %>
<% end %>

<% if @progress_steps.present? %>
  <%= render FlatPack::PageTitle::Component.new(
    title: progress_heading,
    variant: :h2,
    class: "mt-10"
  ) %>
  <%= render FlatPack::List::Component.new(spacing: :dense) do %>
    <% @progress_steps.each do |step| %>
      <%= render FlatPack::List::Item.new(
        trailing: render(FlatPack::Badge::Component.new(
          text: step.badge,
          style: step.badge_style,
          size: :sm
        ))
      ) do %>
        <%= step.label %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
