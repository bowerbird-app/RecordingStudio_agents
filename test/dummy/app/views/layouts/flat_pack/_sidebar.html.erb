<%= render FlatPack::Sidebar::Component.new(side: sidebar_side) do |sidebar| %>
  <% sidebar.header do %>
    <%= render FlatPack::Sidebar::Header::Component.new(
      brand_abbr: "AG",
      title: "Agents"
    ) %>
  <% end %>

  <% sidebar.items do %>
    <nav class="py-4 space-y-1" aria-label="Main">
      <% MenuPage.all.each do |page| %>
        <%= render FlatPack::Sidebar::Item::Component.new(
          text: page.name,
          href: page.path,
          icon: page.icon,
          active: page.active?(request)
        ) %>
      <% end %>
    </nav>
  <% end %>

  <% sidebar.footer do %>
    <%= render FlatPack::Sidebar::Footer::Component.new do %>
      <%= render FlatPack::Button::Component.new(
        text: "Sign out",
        style: :ghost,
        size: :md,
        url: destroy_user_session_path,
        data: { turbo_method: :delete }
      ) %>
    <% end %>
  <% end %>
<% end %>
