<%= form_with url: playground_path, method: :post do %>
  <%= hidden_field_tag :choices, "1" %>

  <%= render FlatPack::Select::Component.new(
    name: "agent",
    label: "Agent",
    options: @agent_options,
    value: @form.agent,
    required: true
  ) %>

  <%= render FlatPack::TextArea::Component.new(
    name: "goal",
    label: "Instruction",
    value: @form.goal,
    required: true,
    rows: 4
  ) %>

  <%= render FlatPack::TextArea::Component.new(
    name: "context",
    label: "Context",
    value: @form.context,
    rows: 4
  ) %>

  <%= render FlatPack::Select::Component.new(
    name: "skills",
    label: "Skills",
    options: @skill_options.map { |skill| [ skill.name, skill.token ] },
    value: @form.skills,
    multiple: true,
    placeholder: "No skills"
  ) %>

  <% @catalog.each do |entry| %>
    <% next if entry.tools.empty? %>
    <div data-playground-tools="<%= entry.token %>"<% if entry.token != @form.agent %> hidden<% end %>>
      <%= render FlatPack::PageTitle::Component.new(title: "Tools", variant: :h2) %>
      <% entry.tools.each do |tool| %>
        <%= render FlatPack::Checkbox::Component.new(
          name: "tools[]",
          value: tool.token,
          label: tool.name,
          checked: @form.tools.include?(tool.token),
          disabled: entry.token != @form.agent
        ) %>
      <% end %>
    </div>
  <% end %>

  <%= render FlatPack::Button::Component.new(
    text: "Run",
    style: :primary,
    size: :md,
    type: "submit"
  ) %>
<% end %>

<script type="application/json" id="playground-skill-defaults"><%= @catalog.to_h { |entry| [ entry.token, entry.required_skills.map(&:token) ] }.to_json %></script>
<script>
  function playgroundApplyAgent(chosen, resetSkills) {
    document.querySelectorAll("[data-playground-tools]").forEach(function (group) {
      var visible = group.getAttribute("data-playground-tools") === chosen
      group.hidden = !visible
      group.querySelectorAll("input").forEach(function (input) {
        input.disabled = !visible
      })
    })
    if (!resetSkills) return
    var defaults = JSON.parse(document.getElementById("playground-skill-defaults").textContent)
    var wanted = defaults[chosen] || []
    var select = document.querySelector("select[name='skills[]']")
    if (!select) return
    Array.prototype.forEach.call(select.options, function (option) {
      option.selected = wanted.indexOf(option.value) !== -1
    })
  }

  document.addEventListener("change", function (event) {
    if (event.target.name !== "agent") return
    playgroundApplyAgent(event.target.value, true)
  })
</script>
