<%= form_with url: playground_path, method: :post do %>
  <%= hidden_field_tag :choices, "1" %>

  <%= render FlatPack::Grid::Component.new(cols: 1, gap: :md) do %>
  <%= render FlatPack::Select::Component.new(
    name: "agent",
    label: "Agent",
    options: @agent_options,
    value: @form.agent,
    required: true
  ) %>

  <%= render FlatPack::TextArea::Component.new(
    name: "goal",
    label: "Instruction",
    value: @form.goal,
    required: true,
    rows: 4
  ) %>

  <%= render FlatPack::TextArea::Component.new(
    name: "context",
    label: "Context",
    value: @form.context,
    rows: 4
  ) %>

  <div data-playground-skills>
    <%= render FlatPack::Select::Component.new(
      name: "skills",
      label: "Skills",
      options: @skill_options.map { |skill| [ skill.name, skill.token ] },
      value: @form.skills,
      multiple: true,
      searchable: true,
      placeholder: "No skills"
    ) %>
  </div>

  <% @catalog.each do |entry| %>
    <% next if entry.tools.empty? %>
    <% active = entry.token == @form.agent %>
    <fieldset data-playground-tools="<%= entry.token %>"<% unless active %> disabled hidden<% end %>>
      <%= render FlatPack::Select::Component.new(
        name: "tools",
        label: "Tools",
        options: entry.tools.map { |tool| [ tool.name, tool.token ] },
        value: active ? @form.tools : entry.tools.map(&:token),
        multiple: true,
        searchable: true,
        placeholder: "No tools",
        disabled: !active
      ) %>
    </fieldset>
  <% end %>

  <%= render FlatPack::Button::Component.new(
    text: "Run",
    style: :primary,
    size: :md,
    type: "submit"
  ) %>
  <% end %>
<% end %>

<script type="application/json" id="playground-skill-defaults"><%= raw @catalog.to_h { |entry| [ entry.token, entry.required_skills.map(&:token) ] }.to_json %></script>
<script>
  function playgroundApplyAgent(chosen, resetSkills) {
    document.querySelectorAll("[data-playground-tools]").forEach(function (group) {
      var visible = group.getAttribute("data-playground-tools") === chosen
      group.hidden = !visible
      group.disabled = !visible
    })
    if (!resetSkills) return
    var defaults = JSON.parse(document.getElementById("playground-skill-defaults").textContent)
    var wanted = defaults[chosen] || []
    var skills = document.querySelector("[data-playground-skills]")
    if (!skills) return
    skills.querySelectorAll("[role='option']").forEach(function (option) {
      var selected = option.getAttribute("aria-selected") === "true"
      var should = wanted.indexOf(option.getAttribute("data-value")) !== -1
      if (selected !== should) option.click()
    })
  }

  document.addEventListener("change", function (event) {
    if (event.target.name !== "agent") return
    playgroundApplyAgent(event.target.value, true)
  })
</script>
