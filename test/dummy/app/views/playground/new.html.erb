<% content_for :title, "Playground" %>

<%= render FlatPack::PageTitle::Component.new(
  title: "Playground",
  subtitle: "Try an agent on this workspace and watch the steps.",
  variant: :h1
) %>

<% if @error.present? %>
  <%= render FlatPack::Alert::Component.new(
    description: @error,
    style: :danger
  ) %>
<% end %>

<%= form_with url: playground_path, method: :post do %>
  <%= render FlatPack::Select::Component.new(
    name: "agent",
    label: "Agent",
    options: @agent_options,
    value: @form.agent,
    required: true
  ) %>

  <%= render FlatPack::TextArea::Component.new(
    name: "goal",
    label: "Instruction",
    value: @form.goal,
    required: true,
    rows: 4
  ) %>

  <%= render FlatPack::TextArea::Component.new(
    name: "context",
    label: "Context",
    value: @form.context,
    rows: 4
  ) %>

  <% @catalog.each do |entry| %>
    <% next unless entry.extra_help? %>
    <div data-playground-help="<%= entry.token %>"<% if entry.token != @form.agent %> hidden<% end %>>
      <%= render FlatPack::PageTitle::Component.new(title: "Extra help", variant: :h2) %>
      <% entry.optional_skills.each do |skill| %>
        <%= render FlatPack::Checkbox::Component.new(
          name: "extra_skills[]",
          value: skill.token,
          label: skill.name,
          checked: @form.extra_skills.include?(skill.token)
        ) %>
      <% end %>
      <% entry.packs.each do |pack| %>
        <%= render FlatPack::Checkbox::Component.new(
          name: "pack",
          value: pack.token,
          label: pack.name,
          checked: Array(@form.pack).include?(pack.token)
        ) %>
      <% end %>
    </div>
  <% end %>

  <%= render FlatPack::Button::Component.new(
    text: "Run",
    style: :primary,
    size: :md,
    type: "submit"
  ) %>
<% end %>

<script>
  document.addEventListener("change", function (event) {
    if (event.target.name !== "agent") return
    var chosen = event.target.value
    document.querySelectorAll("[data-playground-help]").forEach(function (group) {
      var visible = group.getAttribute("data-playground-help") === chosen
      group.hidden = !visible
      if (!visible) {
        group.querySelectorAll("input").forEach(function (input) { input.checked = false })
      }
    })
  })
</script>
