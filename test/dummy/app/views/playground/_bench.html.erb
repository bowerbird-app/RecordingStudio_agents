<% content_for :title, "Playground" %>

<%= render FlatPack::PageTitle::Component.new(
  title: "Playground",
  subtitle: "Try an agent on this workspace and watch the steps.",
  variant: :h1
) %>

<div id="playground-error">
  <%= render "error" %>
</div>

<%= render FlatPack::Grid::Component.new(cols: 2, gap: :lg, align: :start) do %>
  <div>
    <%= render "form" %>
  </div>
  <div
    id="playground-results"
    <% if @refresh %>
      data-controller="playground-watch"
      data-playground-watch-url-value="<%= playground_run_path(params[:idempotency_key], steps: 1) %>"
      data-playground-watch-active-value="true"
    <% end %>
  >
    <%= render "results" %>
  </div>
<% end %>
