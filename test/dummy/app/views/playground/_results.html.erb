<% if @steps.any? %>
  <%= render FlatPack::Grid::Component.new(cols: 1, gap: :md) do %>
    <% @steps.each do |step| %>
      <%= render FlatPack::Collapse::Component.new(
        id: step.id,
        title: step.title,
        open: false,
        left_slot: render(FlatPack::Badge::Component.new(
          text: step.badge,
          style: step.badge_style,
          size: :sm
        ))
      ) do %>
        <p><%= step.body %></p>
        <% if step.arguments_text.present? %>
          <%= render FlatPack::CodeBlock::Component.new(
            title: "Passed in",
            code: step.arguments_text,
            language: "json",
            wrap: true
          ) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
