<% if @steps.any? %>
  <%= render FlatPack::Grid::Component.new(cols: 1, gap: :md) do %>
    <% @steps.each do |step| %>
      <%= render FlatPack::Collapse::Component.new(
        id: step.id,
        title: step.title,
        open: false,
        left_slot: render(FlatPack::Badge::Component.new(
          text: step.badge,
          style: step.badge_style,
          size: :sm
        ))
      ) do %>
        <%= render FlatPack::PageTitle::Component.new(title: "Given", variant: :h4) %>
        <%= simple_format(step.given) %>
        <%= render FlatPack::PageTitle::Component.new(title: "Returned", variant: :h4) %>
        <%= simple_format(step.returned) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
